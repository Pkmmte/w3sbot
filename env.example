# Required - Get these from Discord Developer Portal
# https://discord.com/developers/applications
DISCORD_TOKEN="your_bot_token_here"
DISCORD_CLIENT_ID="your_client_id_here"

# Recommended for development
DISCORD_GUILD_ID="your_test_server_id_here"

# Optional - for quotes module
THEY_SAID_SO_API_KEY="your_api_key_here"

# Optional - for debug messages (unless using hardcoded value in config)
DISCORD_DEBUG_CHANNEL_ID="your_debug_channel_id_here"

# Optional - environment mode
NODE_ENV="development"
